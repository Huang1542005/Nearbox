# NearBox Backend Environment Variables
# Copy to .env and adjust as needed. All have defaults in docker-compose.yml.

DEBUG=True
SECRET_KEY=insecure-dev-key-change-me

# PostgreSQL
POSTGRES_DB=nearbox
POSTGRES_USER=nearbox
POSTGRES_PASSWORD=nearbox
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=

# NearBox
SEED_DEMO=true
RISK_FUND_RATE=0.04
PUBLIC_BASE_URL=http://localhost:8000
